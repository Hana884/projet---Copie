reticulate::py_run_string("
import nbformat
from nbclient import NotebookClient
from pathlib import Path
source = Path('Mini_Projet_Series_Temporelles.ipynb')
destination = Path('Mini_Projet_Series_Temporelles_execute.ipynb')
notebook = nbformat.read(source, as_version=4)
client = NotebookClient(
notebook,
timeout=1800,
kernel_name='python3',
resources={'metadata': {'path': str(source.resolve().parent)}},
allow_errors=False
)
result = client.execute()
nbformat.write(result, destination)
print('NOTEBOOK EXECUTE AVEC SUCCES')
print('Fichier des resultats:', destination.resolve())
")
reticulate::py_last_error()
python_exe <- reticulate::py_exe()
print(python_exe)
system2(
python_exe,
args = c("-c", shQuote("print('PYTHON INDEPENDANT OK')")),
stdout = TRUE,
stderr = TRUE
)
python_exe <- reticulate::py_exe()
system2(
python_exe,
args = c(
"-m", "jupyter", "nbconvert",
"--to", "notebook",
"--execute",
"--ExecutePreprocessor.timeout=1800",
"--output", "Mini_Projet_Series_Temporelles_execute.ipynb",
"Mini_Projet_Series_Temporelles.ipynb"
),
stdout = "",
stderr = ""
)
reticulate::py_run_string("
import nbformat
from pathlib import Path
p = Path('Mini_Projet_Series_Temporelles_execute.ipynb')
print('Fichier existe:', p.exists())
nb = nbformat.read(p, as_version=4)
cells = [c for c in nb.cells if c.cell_type == 'code']
errors = []
for i, cell in enumerate(nb.cells, start=1):
for output in cell.get('outputs', []):
if output.get('output_type') == 'error':
errors.append((i, output.get('ename'), output.get('evalue')))
executed = sum(c.get('execution_count') is not None for c in cells)
with_outputs = sum(len(c.get('outputs', [])) > 0 for c in cells)
print('Total cellules de code:', len(cells))
print('Cellules executees:', executed)
print('Cellules avec outputs:', with_outputs)
print('Nombre d erreurs:', len(errors))
for cell_no, name, message in errors:
print(f'Cellule {cell_no}: {name}: {message}')
")
reticulate::py_run_string("
import nbformat
from pathlib import Path
p = Path('Mini_Projet_Series_Temporelles_execute.ipynb')
nb = nbformat.read(p, as_version=4)
for i, cell in enumerate(nb.cells, start=1):
if cell.cell_type != 'code':
continue
outputs = cell.get('outputs', [])
if not outputs:
continue
types = []
for out in outputs:
if out.output_type == 'stream':
types.append('texte')
elif out.output_type in ('execute_result', 'display_data'):
data = out.get('data', {})
if 'image/png' in data:
types.append('graphique')
if 'text/plain' in data:
types.append('resultat')
if 'text/html' in data:
types.append('HTML/tableau')
elif out.output_type == 'error':
types.append('ERREUR')
print(f'Cellule {i}: ' + ', '.join(types))
")
reticulate::py_run_string("
import nbformat
nb = nbformat.read(
'Mini_Projet_Series_Temporelles_execute.ipynb',
as_version=4
)
for i, cell in enumerate(nb.cells, start=1):
if cell.cell_type != 'code':
continue
code = cell.source.strip().splitlines()
if not code:
continue
source = ' '.join(line.strip() for line in code[:3])
print(f'\\n--- Cellule {i} ---')
print('CODE:', source[:220])
for out in cell.get('outputs', []):
if out.output_type == 'stream':
txt = out.get('text', '').strip()
if txt:
print('RESULTAT:', txt[:700])
elif out.output_type in ('execute_result', 'display_data'):
data = out.get('data', {})
txt = data.get('text/plain', '')
if txt:
print('RESULTAT:', txt[:500])
")
file.exists("Mini_Projet_Series_Temporelles_execute.ipynb")
browseURL(normalizePath("Mini_Projet_Series_Temporelles_execute.ipynb"))
# Vérifier les dossiers et fichiers du projet
cat("Dossier du projet :", getwd(), "\n\n")
cat("Dossiers disponibles :\n")
print(list.dirs(".", recursive = TRUE, full.names = TRUE))
cat("\nFichiers de résultats :\n")
print(list.files(
".",
pattern = "\\.(png|jpg|jpeg|csv|xlsx|html|pdf|rds)$",
recursive = TRUE,
full.names = TRUE
))
# 1. Vérifier le notebook exécuté
stopifnot(file.exists("Mini_Projet_Series_Temporelles_execute.ipynb"))
# 2. Créer les dossiers de résultats
dir.create("results/figures", recursive = TRUE, showWarnings = FALSE)
dir.create("results/tables", recursive = TRUE, showWarnings = FALSE)
dir.create("results/forecasts", recursive = TRUE, showWarnings = FALSE)
# 3. Préparer un script pour extraire les résultats du notebook
script <- c(
"import json, base64, os",
"from pathlib import Path",
"nb = json.load(open('Mini_Projet_Series_Temporelles_execute.ipynb', encoding='utf-8'))",
"fig = Path('results/figures')",
"tab = Path('results/tables')",
"fig.mkdir(parents=True, exist_ok=True)",
"tab.mkdir(parents=True, exist_ok=True)",
"nimg = 0",
"nhtml = 0",
"for i, cell in enumerate(nb.get('cells', []), 1):",
"    for j, out in enumerate(cell.get('outputs', []), 1):",
"        data = out.get('data', {})",
"        if 'image/png' in data:",
"            raw = data['image/png']",
"            if isinstance(raw, list): raw = ''.join(raw)",
"            (fig / f'figure_cell_{i}_{j}.png').write_bytes(base64.b64decode(raw))",
"            nimg += 1",
"        if 'text/html' in data:",
"            raw = data['text/html']",
"            if isinstance(raw, list): raw = ''.join(raw)",
"            if '<table' in raw.lower():",
"                (tab / f'table_cell_{i}_{j}.html').write_text(raw, encoding='utf-8')",
"                nhtml += 1",
"print('Graphiques extraits :', nimg)",
"print('Tableaux HTML extraits :', nhtml)",
"print('Dossier figures :', fig.resolve())",
"print('Dossier tables :', tab.resolve())"
)
writeLines(script, "extract_notebook_outputs.py")
# 4. Exécuter le script avec Python
python_exe <- reticulate::py_exe()
status <- system2(
python_exe,
args = shQuote(normalizePath("extract_notebook_outputs.py")),
stdout = "",
stderr = ""
)
cat("Code de retour :", status, "\n")
# Vérifier le notebook exécuté
stopifnot(file.exists("Mini_Projet_Series_Temporelles_execute.ipynb"))
# Créer les dossiers
dir.create("results/figures", recursive = TRUE, showWarnings = FALSE)
dir.create("results/tables", recursive = TRUE, showWarnings = FALSE)
dir.create("results/forecasts", recursive = TRUE, showWarnings = FALSE)
# Script Python d'extraction
script <- c(
"import json, base64",
"from pathlib import Path",
"nb = json.load(open('Mini_Projet_Series_Temporelles_execute.ipynb', encoding='utf-8'))",
"fig = Path('results/figures')",
"tab = Path('results/tables')",
"nimg = 0",
"ntab = 0",
"for i, cell in enumerate(nb.get('cells', []), 1):",
"    for j, out in enumerate(cell.get('outputs', []), 1):",
"        data = out.get('data', {})",
"        if 'image/png' in data:",
"            raw = data['image/png']",
"            if isinstance(raw, list): raw = ''.join(raw)",
"            (fig / f'figure_cell_{i}_{j}.png').write_bytes(base64.b64decode(raw))",
"            nimg += 1",
"        txt = data.get('text/plain', '')",
"        if isinstance(txt, list): txt = ''.join(txt)",
"        if txt.strip() and len(txt) < 100000 and ('DataFrame' in txt or 'MSE' in txt or 'RMSE' in txt or 'Statistiques' in txt or 'Variable' in txt):",
"            (tab / f'resultat_cell_{i}_{j}.txt').write_text(txt, encoding='utf-8')",
"            ntab += 1",
"print('Graphiques extraits :', nimg)",
"print('Résultats texte extraits :', ntab)",
"print('Figures :', fig.resolve())",
"print('Tables :', tab.resolve())"
)
writeLines(script, "extract_notebook_outputs.py")
python_exe <- reticulate::py_exe()
status <- system2(
python_exe,
args = shQuote(normalizePath("extract_notebook_outputs.py")),
stdout = "",
stderr = ""
)
cat("Code de retour :", status, "\n")
# Vérifier le notebook exécuté
stopifnot(file.exists("Mini_Projet_Series_Temporelles_execute.ipynb"))
# Créer le dossier des résultats
dir.create("results/tables", recursive = TRUE, showWarnings = FALSE)
# Script Python pour récupérer les résultats
script <- c(
"import json",
"from pathlib import Path",
"nb = json.load(open('Mini_Projet_Series_Temporelles_execute.ipynb', encoding='utf-8'))",
"outdir = Path('results/tables')",
"n = 0",
"for i, cell in enumerate(nb.get('cells', []), 1):",
"    for j, out in enumerate(cell.get('outputs', []), 1):",
"        data = out.get('data', {})",
"        html = data.get('text/html', '')",
"        if isinstance(html, list): html = ''.join(html)",
"        if html and '<table' in html.lower():",
"            (outdir / f'table_cell_{i}_{j}.html').write_text(html, encoding='utf-8')",
"            n += 1",
"        txt = data.get('text/plain', '')",
"        if isinstance(txt, list): txt = ''.join(txt)",
"        if txt.strip():",
"            (outdir / f'resultat_cell_{i}_{j}.txt').write_text(txt, encoding='utf-8')",
"            n += 1",
"        if out.get('output_type') == 'stream':",
"            txt = out.get('text', '')",
"            if isinstance(txt, list): txt = ''.join(txt)",
"            if txt.strip():",
"                (outdir / f'console_cell_{i}_{j}.txt').write_text(txt, encoding='utf-8')",
"                n += 1",
"print('Fichiers de résultats extraits :', n)",
"print('Dossier :', outdir.resolve())"
)
writeLines(script, "extract_results.py")
python_exe <- reticulate::py_exe()
status <- system2(
python_exe,
args = shQuote(normalizePath("extract_results.py")),
stdout = "",
stderr = ""
)
cat("Code de retour :", status, "\n")
list.files("results/tables", full.names = TRUE)
# Lire les résultats extraits
files <- list.files(
"results/tables",
pattern = "\\.txt$",
full.names = TRUE
)
for (f in files) {
cat("\n\n")
cat("========================================\n")
cat("FICHIER :", basename(f), "\n")
cat("========================================\n")
cat(readLines(f, warn = FALSE, encoding = "UTF-8"), sep = "\n")
}
# 1. Tableau final des performances
performance <- data.frame(
Modele = c(
"Naif",
"ARIMA(1,1,4)",
"LSTM",
"GRU",
"Hybride ARIMA+LSTM"
),
MSE = c(0.2888, 0.2998, 2.0547, 0.6447, 0.3342),
RMSE = c(0.5374, 0.5475, 1.4334, 0.8029, 0.5781),
MAE = c(0.4142, 0.4159, 1.2682, 0.6562, 0.4442),
MAPE_pct = c(0.661, 0.663, 1.993, 1.034, 0.711),
DM_stat = c(NA, -1.221, -11.337, -6.086, -2.172),
DM_p_value = c(NA, 0.2221, 0, 0, 0.0299)
)
write.csv(
performance,
"results/tables/tableau_performance_modeles.csv",
row.names = FALSE,
na = ""
)
# 2. Tableau de stationnarite
stationnarite <- data.frame(
Variable = c("KO_Close", "PEP_Close", "KO_Return", "PEP_Return"),
