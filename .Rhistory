KPSS_stat = c(5.3080, 5.9186, 0.0263, 0.0781),
KPSS_p_value = c(0.0100, 0.0100, 0.1000, 0.1000),
Conclusion = c(
"Non stationnaire",
"Non stationnaire",
"Stationnaire",
"Stationnaire"
)
)
write.csv(
stationnarite,
"results/tables/tableau_stationnarite.csv",
row.names = FALSE
)
# 3. Tableau des diagnostics
diagnostics <- data.frame(
Test = c(
"Ljung-Box residus ARIMA (lag 20)",
